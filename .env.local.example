# Copy this file to .env.local for local development, and set the same
# three values in Vercel under Project Settings -> Environment Variables
# for production. See README.md "Google Sheets setup" for how to get
# these values.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the private_key value from the downloaded JSON key file exactly
# as-is (it already contains literal \n sequences) -- keep the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# The long ID in your spreadsheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Optional: the tab/sheet name to append rows to. Defaults to "Sheet1".
GOOGLE_SHEET_TAB=Sheet1

# For the Summary page's "Email Report" button (sends to the patient's
# email from Intake) -- a Gmail account + App Password, via SMTP. See
# README.md "Email setup" for how to generate the App Password.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# ---- Research app ----
# Gaze engine: "mediapipe" (default, needs /calibrate) or "opencv" (original engine).
NEXT_PUBLIC_GAZE_ENGINE=mediapipe

# Set to 1 ONLY on your own computer to enable /dev/drive-spike (Google Drive upload test).
# Never set this in Vercel production.
ENABLE_DEV_TOOLS=0

# Set to 1 only where the internet is blocked; the app builds but MediaPipe can't load.
# SKIP_MEDIAPIPE_MODEL=1

# ---- Supabase (Research app, Phase 2) ----
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never expose it in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used in invite emails' links (defaults to the request origin).
APP_URL=https://research.lookat-me.online
